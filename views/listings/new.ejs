<% layout("/layout/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2" >
    <h2>Create a new Listing</h2>
    <br/>
    <form method="POST" action="/listings">
        <div>
            <lable for="title" class="form-lable">Title</lable>
            <input name="listing[title]" 
            placeholder="enter title" 
            type="test" 
            class="form-control"/>
        </div>
        <br/>  
        <div>
            <lable for="description" class="form-lable">Description</lable>
            <textarea name="listing[description]" 
            placeholder="enter description" 
            class="form-control">
        </textarea>
        </div>
       <br/> 
       <div>
        <label for="image link" class="form-lable">Image URL</label>
        <input name="listing[image]" 
        placeholder="enter image url"
        class="form-control"/>
       </div>
         <br/> 
         <div class="row">
        <div class="col-md-4">
            <lable for="price" class="form-lable">Price</lable>
            <input name="listing[price]" 
            placeholder="enter price" 
            type="number"
            class="form-control" />
        </div>
        <br/>  
        <div class="col-md-8">
            <lable for="country" class="form-lable">Country</lable>
            <input name="listing[country]" 
            placeholder="enter country name" 
            type="text"
            class="form-control"/>
        </div>
    </div>
        <br/>  
        <div>
            <lable for="location" class="form-lable">Location</lable>
            <input name="listing[location]" 
            placeholder="enter location" 
            type="text"
            class="form-control"/>
        </div>
        <br/> 
        <button class="btn btn-dark add-btn mt-3"> Add</button>
    </form>
</div>
</div>
</body>
