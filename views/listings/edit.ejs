<% layout("/layout/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2" >
    <h2>Edit the Listing</h2>
    <br/> 
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
        <div class="md-3">
            <lable for="title" class="form-lable">Title</lable>
            <input name="listing[title]" 
            value="<%= listing.title %>" 
             type="test"
             class="form-control"/>
        </div>
        <br/> 
        <div class="md-3">
            <lable for="description" class="form-lable">Description</lable>
            <textarea name="listing[description]" class="form-control">"<%= listing.description %>"</textarea>
        </div>
        <br/> 
        <div class="md-3">
        <lable for="image link" class="form-lable">Image Link</lable>
        <input name="listing[image]" 
        value="<%= listing.image %>"
        placeholder="enter 
        image url"
        class="form-control"/>
    </div>
    <div class="row">
    <div class="md-3 col-md-4">
        <br/>  
        <lable for="price" class="form-lable">Price</lable>
        <input name="listing[price]" 
        value="<%= listing.price %>" 
        type="number"
        class="form-control" />
    </div>
    <div class="md-3 col-md-4">
        <br/>  
        <lable for="country" class="form-lable">Country</lable>
        <input name="listing[country]" 
        value="<%= listing.country%>" 
        type="text"
        class="form-control"/>
        
    </div>
</div>
    <div class="md-3">
        <br/>  
        <lable for="location" class="form-lable">Location</lable>
        <input name="listing[location]" 
        value="<%= listing.location %>" 
        type="text"
        class="form-control"/>
    </div>
        <br/>  
        <button  class="btn btn-dark add-btn mt-3"> Edit</button>
    </form>
    </div>
    </div>
</body>
